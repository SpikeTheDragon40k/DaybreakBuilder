{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaybreakBuilder",
  "version": "1.2.0",
  "identifier": "io.github.dndbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DaybreakBuilder",
        "create": false,
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "D&D 5e character builder",
    "longDescription": "Open-source, cross-platform D&D 5e character builder that loads Aurora Builder content files.",
    "windows": {
      "wix": {
        "upgradeCode": "0aad4583-4b77-553d-bdb5-f9072fdf769b"
      },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "conflicts": [
          "dndbuilder"
        ],
        "replaces": [
          "dndbuilder"
        ]
      },
      "rpm": {
        "conflicts": [
          "dndbuilder"
        ],
        "obsoletes": [
          "dndbuilder"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
