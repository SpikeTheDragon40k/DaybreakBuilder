	<element name="Fighting Style" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_FIGHTER_FIGHTING_STYLE">
		<description><p>You adopt a particular style of fighting as your specialty. You can’t take a Fighting Style option more than once.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Fighting Style (Fighter)" supports="Fighting Style,Fighter" />
		</rules>
	</element>

	<element name="Second Wind" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_FIGHTER_SECOND_WIND">
		<description><p>On your turn you can use a bonus action to regain hit points equal to 1d10 + your fighter level. Once you use this feature, you must finish a short or long rest before you can use it again.</p></description>
		<sheet>
			<description usage="1/Short Rest" action="Bonus Action">Regain 1d10 + {{level:fighter}} hit points.</description>
		</sheet>
	</element>

	<element name="Action Surge" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_FIGHTER_ACTION_SURGE">
		<description><p>On your turn you can take one additional action. Once you use this feature, you must finish a short or long rest before you can use it again. Starting at 17th level you can use it twice before a rest, but only once on the same turn.</p></description>
		<sheet>
			<description level="2" usage="1/Short Rest">Take one additional action on your turn.</description>
			<description level="17" usage="2/Short Rest">Take one additional action on your turn.</description>
		</sheet>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_FIGHTER_ASI_4">
		<description><p>Increase one ability score by 2 or two ability scores by 1 (maximum 20), or take a feat if your game uses feats.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Improvement Option (Fighter 4)" supports="Improvement Option" />
		</rules>
	</element>

	<element name="Extra Attack" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_FIGHTER_EXTRA_ATTACK">
		<description><p>You can attack twice whenever you take the Attack action on your turn. The number of attacks increases to three at 11th level and four at 20th level.</p></description>
		<sheet>
			<description level="5">You can attack twice when you take the Attack action.</description>
			<description level="11">You can attack three times when you take the Attack action.</description>
			<description level="20">You can attack four times when you take the Attack action.</description>
		</sheet>
	</element>

