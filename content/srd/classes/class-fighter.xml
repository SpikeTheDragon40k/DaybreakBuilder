	<element name="Improved Critical" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_ARCHETYPE_FEATURE_CHAMPION_IMPROVED_CRITICAL">
		<description><p>Your weapon attacks score a critical hit on a roll of 19 or 20.</p></description>
	</element>

	<element name="Remarkable Athlete" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_ARCHETYPE_FEATURE_CHAMPION_REMARKABLE_ATHLETE">
		<description><p>You can add half your proficiency bonus (rounded up) to any Strength, Dexterity or Constitution check you make that doesn’t already use your proficiency bonus. Your running long jump distance increases by a number of feet equal to your Strength modifier.</p></description>
	</element>

	<element name="Additional Fighting Style" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_ARCHETYPE_FEATURE_CHAMPION_ADDITIONAL_FIGHTING_STYLE">
