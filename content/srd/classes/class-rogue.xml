	<element name="Reliable Talent" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_ROGUE_RELIABLE_TALENT">
		<description><p>Whenever you make an ability check that lets you add your proficiency bonus, you can treat a d20 roll of 9 or lower as a 10.</p></description>
	</element>

