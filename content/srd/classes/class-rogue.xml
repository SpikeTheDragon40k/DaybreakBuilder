	<element name="Elusive" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_ROGUE_ELUSIVE">
		<description><p>No attack roll has advantage against you while you aren’t incapacitated.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_ROGUE_ASI_19">
