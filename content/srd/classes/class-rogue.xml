	<element name="Blindsense" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_ROGUE_BLINDSENSE">
		<description><p>If you are able to hear, you are aware of the location of any hidden or invisible creature within 10 feet of you.</p></description>
	</element>

	<element name="Slippery Mind" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_ROGUE_SLIPPERY_MIND">
		<description><p>You have acquired greater mental strength. You gain proficiency in Wisdom saving throws.</p></description>
		<sheet display="false" />
		<rules>
			<grant type="Proficiency" id="ID_PROFICIENCY_SAVINGTHROW_WISDOM" />
		</rules>
	</element>

