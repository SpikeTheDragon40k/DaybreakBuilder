	<element name="Dragon Ancestor" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_ARCHETYPE_FEATURE_DRACONIC_BLOODLINE_DRAGON_ANCESTOR">
		<description><p>You choose one type of dragon as your ancestor. You can speak, read and write Draconic, and when you interact with dragons your proficiency bonus is doubled for Charisma checks.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Archetype Feature" name="Dragon Ancestor" supports="Dragon Ancestor" />
