	<element name="Spellcasting" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_SORCERER_SPELLCASTING">
		<description><p>An event in your past, or in the life of a parent or ancestor, left an indelible mark on you, infusing you with arcane magic. Charisma is your spellcasting ability, and you can use an arcane focus.</p></description>
		<sheet display="false" />
	</element>

	<element name="Font of Magic" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_SORCERER_FONT_OF_MAGIC">
		<description><p>You have a number of sorcery points equal to your sorcerer level, regained on a long rest. As a bonus action you can expend a spell slot to gain sorcery points equal to its level, or spend sorcery points to create a spell slot (1st: 2 points, 2nd: 3, 3rd: 5, 4th: 6, 5th: 7; no higher than 5th level).</p></description>
		<sheet>
			<description usage="Long Rest">{{level:sorcerer}} sorcery points; convert between sorcery points and spell slots as a bonus action.</description>
		</sheet>
	</element>

	<element name="Metamagic" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_SORCERER_METAMAGIC_3">
		<description><p>You gain the ability to twist your spells to suit your needs. You learn two Metamagic options, another at 10th level and another at 17th level. Only one Metamagic option can be used on a spell when you cast it, unless otherwise noted.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Metamagic" supports="Metamagic" number="2" />
		</rules>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_SORCERER_ASI_4">
