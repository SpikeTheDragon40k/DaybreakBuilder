		</rules>
	</element>

	<element name="Draconic Resilience" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_ARCHETYPE_FEATURE_DRACONIC_BLOODLINE_DRACONIC_RESILIENCE">
