	<element name="Cutting Words" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_ARCHETYPE_FEATURE_COLLEGE_OF_LORE_CUTTING_WORDS">
		<description><p>When a creature you can see within 60 feet makes an attack roll, ability check or damage roll, you can use your reaction to expend one Bardic Inspiration and subtract the roll from the creature’s result, after it rolls but before the outcome is known.</p></description>
		<sheet>
			<description action="Reaction">Expend Bardic Inspiration to subtract the die from a creature’s roll.</description>
		</sheet>
	</element>

