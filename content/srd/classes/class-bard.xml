	<element name="Bard" type="Class" source="System Reference Document 5.1" id="ID_WOTC_PHB_CLASS_BARD">
		<description><p>Whether scholar, skald or scoundrel, a bard weaves magic through words and music to inspire allies, demoralize foes, manipulate minds and heal wounds.</p><p>Hit Dice: 1d8 per bard level. Proficiencies: light armor; simple weapons, hand crossbows, longswords, rapiers, shortswords; three musical instruments. Saving throws: Dexterity, Charisma. Skills: choose any three.</p></description>
		<sheet display="false" />
		<setters>
			<set name="hd">d8</set>
			<set name="short">An inspiring magician whose power echoes the music of creation.</set>
			<set name="primary">Charisma</set>
			<set name="starting wealth">5d4x10</set>
		</setters>
		<spellcasting name="Bard" ability="Charisma" prepare="false">
			<list>Bard</list>
		</spellcasting>
