	<element name="Destroy Undead" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_CLERIC_DESTROY_UNDEAD">
		<description><p>When an undead fails its saving throw against your Turn Undead feature, it is instantly destroyed if its challenge rating is at or below 1/2 (rising to CR 1 at 8th level, 2 at 11th, 3 at 14th and 4 at 17th).</p></description>
	</element>

