	<element name="Ranger" type="Class" source="System Reference Document 5.1" id="ID_WOTC_PHB_CLASS_RANGER">
		<description><p>Far from the bustle of cities, rangers keep their unending watch over the wilderness, hunting the monsters that threaten it.</p><p>Hit Dice: 1d10 per ranger level. Proficiencies: light and medium armor, shields, simple and martial weapons. Saving throws: Strength, Dexterity. Skills: choose three from Animal Handling, Athletics, Insight, Investigation, Nature, Perception, Stealth and Survival.</p></description>
		<sheet display="false" />
		<setters>
			<set name="hd">d10</set>
			<set name="short">A warrior who uses martial prowess and nature magic to combat threats on the edges of civilization.</set>
			<set name="primary">Dexterity and Wisdom</set>
		</setters>
		<spellcasting name="Ranger" ability="Wisdom" prepare="false">
			<list>Ranger</list>
		</spellcasting>
