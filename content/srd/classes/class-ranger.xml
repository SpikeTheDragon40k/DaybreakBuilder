	<element name="Feral Senses" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_FERAL_SENSES">
		<description><p>You gain preternatural senses: attacking a creature you can’t see doesn’t impose disadvantage, and you are aware of the location of any invisible creature within 30 feet of you that isn’t hidden.</p></description>
	</element>

