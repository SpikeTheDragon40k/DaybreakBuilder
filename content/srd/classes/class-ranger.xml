	<element name="Colossus Slayer" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_COLOSSUS_SLAYER">
		<supports>Hunter’s Prey</supports>
		<description><p>Once per turn, when you hit a creature that is below its hit point maximum with a weapon attack, it takes an extra 1d8 damage.</p></description>
		<sheet><description>Once per turn, when you hit a creature that is below its hit point maximum with a weapon attack, it takes an extra 1d8 damage.</description></sheet>
	</element>

	<element name="Giant Killer" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_GIANT_KILLER">
		<supports>Hunter’s Prey</supports>
		<description><p>When a Large or larger creature within 5 feet of you hits or misses you with an attack, you can use your reaction to attack that creature immediately after its attack.</p></description>
		<sheet><description>When a Large or larger creature within 5 feet of you hits or misses you with an attack, you can use your reaction to attack that creature immediately after its attack.</description></sheet>
	</element>

	<element name="Horde Breaker" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_HORDE_BREAKER">
		<supports>Hunter’s Prey</supports>
		<description><p>Once on each of your turns when you make a weapon attack, you can make another attack with the same weapon against a different creature within 5 feet of the original target and within range.</p></description>
		<sheet><description>Once on each of your turns when you make a weapon attack, you can make another attack with the same weapon against a different creature within 5 feet of the original target and within range.</description></sheet>
	</element>

	<element name="Escape the Horde" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_ESCAPE_THE_HORDE">
		<supports>Defensive Tactics</supports>
		<description><p>Opportunity attacks against you are made with disadvantage.</p></description>
		<sheet><description>Opportunity attacks against you are made with disadvantage.</description></sheet>
	</element>

	<element name="Multiattack Defense" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_MULTIATTACK_DEFENSE">
		<supports>Defensive Tactics</supports>
		<description><p>When a creature hits you with an attack, you gain a +4 bonus to AC against all subsequent attacks made by that creature for the rest of the turn.</p></description>
		<sheet><description>When a creature hits you with an attack, you gain a +4 bonus to AC against all subsequent attacks made by that creature for the rest of the turn.</description></sheet>
	</element>

	<element name="Steel Will" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_STEEL_WILL">
		<supports>Defensive Tactics</supports>
		<description><p>You have advantage on saving throws against being frightened.</p></description>
		<sheet><description>You have advantage on saving throws against being frightened.</description></sheet>
	</element>

	<element name="Volley" type="Archetype Feature" source="System Reference Document 5.1" id="ID_SRD_HUNTER_OPTION_VOLLEY">
		<supports>Multiattack</supports>
		<description><p>You can use your action to make a ranged attack against any number of creatures within 10 feet of a point you can see within your weapon’s range.</p></description>
		<sheet><description>You can use your action to make a ranged attack against any number of creatures within 10 feet of a point you can see within your weapon’s range.</description></sheet>
