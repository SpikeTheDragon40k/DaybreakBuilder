	<element name="Foe Slayer" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_FOE_SLAYER">
		<description><p>Once on each of your turns, you can add your Wisdom modifier to the attack roll or the damage roll of an attack you make against one of your favored enemies.</p></description>
	</element>

	<element name="Ranger Archetype" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_RANGER_ARCHETYPE">
