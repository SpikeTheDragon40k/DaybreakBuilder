	<element name="Hunter" type="Archetype" source="System Reference Document 5.1" id="ID_WOTC_ARCHETYPE_RANGER_HUNTER">
		<supports>Ranger Archetype, Ranger</supports>
		<description><p>Emulating the Hunter archetype means accepting your place as a bulwark between civilization and the terrors of the wilderness.</p></description>
		<sheet display="false" />
		<rules>
			<grant type="Archetype Feature" id="ID_SRD_ARCHETYPE_FEATURE_HUNTER_HUNTERS_PREY" level="3" />
