	<element name="Favored Enemy" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_FAVORED_ENEMY">
		<description><p>Choose a type of favored enemy (or two races of humanoid). You have advantage on Wisdom (Survival) checks to track them and on Intelligence checks to recall information about them, and you learn one language they speak. You choose one additional favored enemy at 6th and 14th level.</p></description>
		<rules>
			<select type="List" name="Favored Enemy"><item id="1">Aberrations</item><item id="2">Beasts</item><item id="3">Celestials</item><item id="4">Constructs</item><item id="5">Dragons</item><item id="6">Elementals</item><item id="7">Fey</item><item id="8">Fiends</item><item id="9">Giants</item><item id="10">Monstrosities</item><item id="11">Oozes</item><item id="12">Plants</item><item id="13">Undead</item><item id="14">Two races of humanoid</item></select>
			<select type="List" name="Favored Enemy (6th level)" level="6"><item id="1">Aberrations</item><item id="2">Beasts</item><item id="3">Celestials</item><item id="4">Constructs</item><item id="5">Dragons</item><item id="6">Elementals</item><item id="7">Fey</item><item id="8">Fiends</item><item id="9">Giants</item><item id="10">Monstrosities</item><item id="11">Oozes</item><item id="12">Plants</item><item id="13">Undead</item><item id="14">Two races of humanoid</item></select>
			<select type="List" name="Favored Enemy (14th level)" level="14"><item id="1">Aberrations</item><item id="2">Beasts</item><item id="3">Celestials</item><item id="4">Constructs</item><item id="5">Dragons</item><item id="6">Elementals</item><item id="7">Fey</item><item id="8">Fiends</item><item id="9">Giants</item><item id="10">Monstrosities</item><item id="11">Oozes</item><item id="12">Plants</item><item id="13">Undead</item><item id="14">Two races of humanoid</item></select>
			<select type="Language" name="Favored Enemy Language" supports="Standard||Exotic" />
		</rules>
	</element>

	<element name="Natural Explorer" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_NATURAL_EXPLORER">
		<description><p>Choose one type of favored terrain. When you make an Intelligence or Wisdom check related to it, your proficiency bonus is doubled if you use a skill you’re proficient in. While traveling there for an hour or more, difficult terrain doesn’t slow your group, you can’t become lost except by magic, and you remain alert to danger. You choose additional favored terrains at 6th and 10th level.</p></description>
		<rules>
			<select type="List" name="Favored Terrain"><item id="1">Arctic</item><item id="2">Coast</item><item id="3">Desert</item><item id="4">Forest</item><item id="5">Grassland</item><item id="6">Mountain</item><item id="7">Swamp</item><item id="8">Underdark</item></select>
			<select type="List" name="Favored Terrain (6th level)" level="6"><item id="1">Arctic</item><item id="2">Coast</item><item id="3">Desert</item><item id="4">Forest</item><item id="5">Grassland</item><item id="6">Mountain</item><item id="7">Swamp</item><item id="8">Underdark</item></select>
			<select type="List" name="Favored Terrain (10th level)" level="10"><item id="1">Arctic</item><item id="2">Coast</item><item id="3">Desert</item><item id="4">Forest</item><item id="5">Grassland</item><item id="6">Mountain</item><item id="7">Swamp</item><item id="8">Underdark</item></select>
		</rules>
	</element>

	<element name="Fighting Style" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_FIGHTING_STYLE">
		<description><p>You adopt a particular style of fighting as your specialty.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Fighting Style (Ranger)" supports="Fighting Style,Ranger" />
		</rules>
	</element>

	<element name="Spellcasting" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_SPELLCASTING">
		<description><p>You have learned to use the magical essence of nature to cast spells. Wisdom is your spellcasting ability for ranger spells.</p></description>
		<sheet display="false" />
	</element>

	<element name="Primeval Awareness" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_PRIMEVAL_AWARENESS">
		<description><p>You can use your action and expend one ranger spell slot to sense whether aberrations, celestials, dragons, elementals, fey, fiends or undead are present within 1 mile (6 miles in favored terrain) for 1 minute per level of the slot.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_ASI_4">
		<description><p>Increase one ability score by 2 or two ability scores by 1 (maximum 20), or take a feat if your game uses feats.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Improvement Option (Ranger 4)" supports="Improvement Option" />
		</rules>
	</element>

	<element name="Extra Attack" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_EXTRA_ATTACK">
		<description><p>You can attack twice, instead of once, whenever you take the Attack action on your turn.</p></description>
	</element>

	<element name="Land’s Stride" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_LANDS_STRIDE">
		<description><p>Moving through nonmagical difficult terrain costs you no extra movement, and you can pass through nonmagical plants without being slowed or harmed. You have advantage on saves against magically created plants that impede movement.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_ASI_8">
