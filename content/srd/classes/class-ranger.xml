	<element name="Hide in Plain Sight" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_HIDE_IN_PLAIN_SIGHT">
		<description><p>You can spend 1 minute creating camouflage. Once camouflaged, you gain a +10 bonus to Dexterity (Stealth) checks as long as you remain there without moving or taking actions.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_RANGER_ASI_12">
