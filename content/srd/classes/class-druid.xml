	<element name="Druidic" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_DRUID_DRUIDIC">
		<description><p>You know Druidic, the secret language of druids. You can speak it and use it to leave hidden messages.</p></description>
		<sheet display="false" />
		<rules>
			<grant type="Language" id="ID_LANGUAGE_DRUIDIC" />
		</rules>
	</element>

	<element name="Spellcasting" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_DRUID_SPELLCASTING">
		<description><p>Drawing on the divine essence of nature itself, you can cast druid spells. You prepare a number of druid spells equal to your Wisdom modifier + your druid level (minimum one). You can use a druidic focus and cast druid spells as rituals.</p></description>
		<sheet><description>Prepare {{druid:spellcasting:prepare}} druid spells.</description></sheet>
	</element>

	<element name="Wild Shape" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_DRUID_WILD_SHAPE">
		<description><p>As an action, you can magically assume the shape of a beast you have seen before, twice per short or long rest. Maximum CR 1/4 with no flying or swimming speed at 2nd level; CR 1/2 without flying at 4th; CR 1 at 8th. You can stay in beast form for a number of hours equal to half your druid level.</p></description>
		<sheet>
			<description level="2" usage="2/Short Rest" action="Action">Transform into a beast of CR 1/4 or lower (no flying or swimming speed).</description>
			<description level="4" usage="2/Short Rest" action="Action">Transform into a beast of CR 1/2 or lower (no flying speed).</description>
			<description level="8" usage="2/Short Rest" action="Action">Transform into a beast of CR 1 or lower.</description>
		</sheet>
	</element>

