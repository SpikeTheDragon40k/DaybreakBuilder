	<element name="Barbarian" type="Class" source="System Reference Document 5.1" id="ID_WOTC_PHB_CLASS_BARBARIAN">
		<description><p>Barbarians are defined by their rage: unbridled, unquenchable and unthinking fury. They are hardy warriors who shrug off blows and wade into battle.</p><p>Hit Dice: 1d12 per barbarian level. Proficiencies: light and medium armor, shields, simple and martial weapons. Saving throws: Strength, Constitution. Skills: choose two from Animal Handling, Athletics, Intimidation, Nature, Perception and Survival.</p></description>
		<sheet display="false" />
		<setters>
			<set name="hd">d12</set>
			<set name="short">A fierce warrior of primitive background who can enter a battle rage.</set>
			<set name="primary">Strength</set>
		</setters>
		<multiclass id="ID_WOTC_PHB_MULTICLASS_BARBARIAN">
			<prerequisite>Strength 13</prerequisite>
			<requirements>[str:13]</requirements>
			<setters><set name="multiclass proficiencies">Shields, simple weapons, martial weapons</set></setters>
			<rules>
				<grant type="Grants" id="ID_INTERNAL_GRANT_MULTICLASS" />
