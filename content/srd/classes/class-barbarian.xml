	<element name="Rage" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_RAGE">
		<description><p>On your turn you can enter a rage as a bonus action. While raging (and not wearing heavy armor) you have advantage on Strength checks and saving throws, a bonus to melee weapon damage rolls using Strength, and resistance to bludgeoning, piercing and slashing damage. You can’t cast or concentrate on spells. Rage lasts 1 minute and ends early if you are knocked unconscious or haven’t attacked or taken damage since your last turn.</p></description>
		<sheet>
			<description usage="{{rage:count}}/Long Rest" action="Bonus Action">Bonus action: advantage on Strength checks and saves, +{{rage:damage}} melee damage, resistance to bludgeoning, piercing and slashing damage.</description>
		</sheet>
		<rules>
			<stat name="rage:count" value="2" level="1" />
			<stat name="rage:count" value="1" level="3" />
			<stat name="rage:count" value="1" level="6" />
			<stat name="rage:count" value="1" level="12" />
			<stat name="rage:count" value="1" level="17" />
			<stat name="rage:count" value="93" level="20" />
			<stat name="rage:damage" value="2" level="1" />
			<stat name="rage:damage" value="1" level="9" />
			<stat name="rage:damage" value="1" level="16" />
		</rules>
	</element>

	<element name="Unarmored Defense" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_UNARMORED_DEFENSE">
		<description><p>While you are not wearing any armor, your Armor Class equals 10 + your Dexterity modifier + your Constitution modifier. You can use a shield and still gain this benefit.</p></description>
		<rules>
			<stat name="ac:barbarian" value="10" />
			<stat name="ac:barbarian" value="dexterity:modifier" />
			<stat name="ac:barbarian" value="constitution:modifier" />
			<stat name="ac:calculation" value="ac:barbarian" bonus="calculation" equipped="[armor:none]" alt="Unarmored Defense" />
		</rules>
	</element>

	<element name="Reckless Attack" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_RECKLESS_ATTACK">
		<description><p>When you make your first attack on your turn, you can attack recklessly: you gain advantage on melee weapon attack rolls using Strength this turn, but attack rolls against you have advantage until your next turn.</p></description>
	</element>

	<element name="Danger Sense" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_DANGER_SENSE">
		<description><p>You have advantage on Dexterity saving throws against effects you can see, such as traps and spells, while you aren’t blinded, deafened or incapacitated.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_ASI_4">
		<description><p>Increase one ability score by 2 or two ability scores by 1 (maximum 20), or take a feat if your game uses feats.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Improvement Option (Barbarian 4)" supports="Improvement Option" />
		</rules>
	</element>

	<element name="Extra Attack" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_EXTRA_ATTACK">
		<description><p>You can attack twice, instead of once, whenever you take the Attack action on your turn.</p></description>
	</element>

	<element name="Fast Movement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_FAST_MOVEMENT">
		<description><p>Your speed increases by 10 feet while you aren’t wearing heavy armor.</p></description>
		<rules>
			<stat name="speed:misc" value="10" equipped="![armor:heavy]" alt="Fast Movement" />
		</rules>
	</element>

	<element name="Feral Instinct" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_FERAL_INSTINCT">
		<description><p>You have advantage on initiative rolls. If you are surprised at the start of combat, you can act normally on your first turn if you enter your rage first.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_ASI_8">
		<description><p>Increase one ability score by 2 or two ability scores by 1 (maximum 20), or take a feat if your game uses feats.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Improvement Option (Barbarian 8)" supports="Improvement Option" />
		</rules>
	</element>

	<element name="Brutal Critical" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_BRUTAL_CRITICAL">
		<description><p>You can roll one additional weapon damage die when determining the extra damage for a critical hit with a melee attack. This increases to two additional dice at 13th level and three at 17th level.</p></description>
		<sheet><description>Roll {{brutal critical:dice}} additional weapon damage dice on a melee critical hit.</description></sheet>
		<rules>
			<stat name="brutal critical:dice" value="1" level="9" />
			<stat name="brutal critical:dice" value="1" level="13" />
			<stat name="brutal critical:dice" value="1" level="17" />
		</rules>
	</element>

	<element name="Relentless Rage" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_RELENTLESS_RAGE">
		<description><p>If you drop to 0 hit points while raging and don’t die outright, you can make a DC 10 Constitution saving throw to drop to 1 hit point instead. Each use after the first increases the DC by 5 until you finish a short or long rest.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_ASI_12">
		<description><p>Increase one ability score by 2 or two ability scores by 1 (maximum 20), or take a feat if your game uses feats.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Improvement Option (Barbarian 12)" supports="Improvement Option" />
		</rules>
	</element>

	<element name="Persistent Rage" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_PERSISTENT_RAGE">
		<description><p>Your rage is so fierce that it ends early only if you fall unconscious or if you choose to end it.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_ASI_16">
		<description><p>Increase one ability score by 2 or two ability scores by 1 (maximum 20), or take a feat if your game uses feats.</p></description>
		<sheet display="false" />
		<rules>
			<select type="Class Feature" name="Improvement Option (Barbarian 16)" supports="Improvement Option" />
		</rules>
	</element>

	<element name="Indomitable Might" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_INDOMITABLE_MIGHT">
		<description><p>If your total for a Strength check is less than your Strength score, you can use that score in place of the total.</p></description>
	</element>

	<element name="Ability Score Improvement" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_BARBARIAN_ASI_19">
