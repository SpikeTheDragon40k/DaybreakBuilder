	<element name="Aura of Courage" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_PALADIN_AURA_OF_COURAGE">
		<description><p>You and friendly creatures within 10 feet of you can’t be frightened while you are conscious. At 18th level the range becomes 30 feet.</p></description>
	</element>

