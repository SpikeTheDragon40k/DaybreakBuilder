	<element name="Extra Attack" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_PALADIN_EXTRA_ATTACK">
		<description><p>You can attack twice, instead of once, whenever you take the Attack action on your turn.</p></description>
	</element>

	<element name="Aura of Protection" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_PALADIN_AURA_OF_PROTECTION">
		<description><p>Whenever you or a friendly creature within 10 feet of you must make a saving throw, the creature gains a bonus equal to your Charisma modifier (minimum +1). You must be conscious. At 18th level the range becomes 30 feet.</p></description>
		<rules>
			<stat name="strength:save:misc" value="charisma:modifier" minimum="1" bonus="aura of protection" alt="Aura of Protection" />
