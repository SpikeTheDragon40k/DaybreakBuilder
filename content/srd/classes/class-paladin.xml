			<stat name="wisdom:save:misc" value="charisma:modifier" minimum="1" bonus="aura of protection" alt="Aura of Protection" />
			<stat name="charisma:save:misc" value="charisma:modifier" minimum="1" bonus="aura of protection" alt="Aura of Protection" />
		</rules>
	</element>

