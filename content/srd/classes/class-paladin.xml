	<element name="Sacred Oath" type="Class Feature" source="System Reference Document 5.1" id="ID_SRD_CLASS_FEATURE_PALADIN_SACRED_OATH">
		<description><p>At 3rd level you swear the oath that binds you as a paladin forever.</p></description>
		<sheet display="false" />
